{
  "git": {
    "commitMessage": "chore(release): v${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}",
    "push": false,
    "requireCleanWorkingDir": true,
    "commit": false,
    "tag": false,
    "requireUpstream": false
  },
  "npm": {
    "publish": false,
    "versionArgs": [
      "--ignore-scripts"
    ]
  },
  "github": {
    "release": false,
    "releaseName": "v${version}",
    "tokenRef": "RELEASE_GITHUB_TOKEN"
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "header": "# Changelog"
    }
  }
}
